rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    // La app solo loguea con Google (email siempre verificado). Exigir
    // email_verified evita que una cuenta con email no verificado se haga
    // pasar por otra si algún día se habilita otro proveedor.
    function logueado() {
      return request.auth != null;
    }

    function emailVerificado() {
      return logueado() && request.auth.token.email_verified == true;
    }

    // ESPEJO de ADMIN_EMAIL (frontend/src/config/constants.js y backend/src/constants.js).
    function esAdminGlobal() {
      return emailVerificado() && request.auth.token.email == "mosquerafran265@gmail.com";
    }

    function esMiembroDe(grupoId) {
      return emailVerificado()
        && grupoId is string && grupoId != ""
        && request.auth.token.email in get(/databases/$(database)/documents/grupos/$(grupoId)).data.miembros;
    }

    function esTextoCorto(valor, max) {
      return valor is string && valor.size() <= max;
    }

    // Campos que cambian en esta escritura. En create son todos; en update,
    // solo los tocados: así un doc viejo con un campo "raro" que no se edita
    // no queda bloqueado para siempre.
    function camposTocados() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    // Si el campo se toca, tiene que cumplir el chequeo.
    function textoOk(campo, max) {
      return !(campo in camposTocados()) || esTextoCorto(request.resource.data[campo], max);
    }

    function listaOk(campo, max) {
      return !(campo in camposTocados())
        || (request.resource.data[campo] is list && request.resource.data[campo].size() <= max);
    }

    // Modelo del cuerpo (config/entrenos.ts → Sexo).
    function sexoOk() {
      return !("sexo" in camposTocados())
        || request.resource.data.sexo in ["hombre", "mujer"];
    }

    function metaSemanalOk() {
      return !("metaSemanal" in camposTocados())
        || (request.resource.data.metaSemanal is int
            && request.resource.data.metaSemanal >= 1
            && request.resource.data.metaSemanal <= 7);
    }

    // ── Usuarios (doc id = email) ─────────────────────────────────────────────
    // Cada uno lee SOLO su doc (fase 2: antes cualquiera veía emails y nombres de
    // todos); el admin global lee todos (pantalla Aprobaciones). Cada uno escribe su propio doc,
    // pero NUNCA su `estado`: al crearlo solo puede nacer aprobado/pendiente
    // (política actual de auto-aprobación, context.md §9.1) y después no se
    // toca. El admin global sí cambia el `estado` de otros (pantalla Aprobaciones).
    match /usuarios/{email} {
      function esPropio() {
        return emailVerificado() && request.auth.token.email == email;
      }

      allow read: if esPropio() || esAdminGlobal();

      // uid/email: si vienen, tienen que ser los tuyos (docs viejos pueden no tenerlos).
      function identidadOk() {
        return request.resource.data.get("uid", request.auth.uid) == request.auth.uid
          && request.resource.data.get("email", email) == email;
      }

      allow create: if esPropio()
        && request.resource.data.get("estado", "pendiente") in ["aprobado", "pendiente"]
        && identidadOk()
        && metaSemanalOk()
        && sexoOk();

      allow update: if (esPropio()
          && !("estado" in camposTocados())
          && identidadOk()
          && metaSemanalOk()
          && sexoOk())
        || (esAdminGlobal()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado"])
          && request.resource.data.estado in ["aprobado", "pendiente", "rechazado"]);

      allow delete: if false;
    }

    // ── Categorías: plantillas personales (tipo, músculos, si suma al ranking) ──
    match /categorias/{catId} {
      function categoriaValida() {
        return textoOk("nombre", 40)
          && (!("cuenta" in camposTocados()) || request.resource.data.cuenta is bool)
          && (!("activo" in camposTocados()) || request.resource.data.activo is bool)
          && (!("tipo" in camposTocados()) || request.resource.data.tipo in ["gym", "futbol", "running", "otro"])
          && listaOk("musculos", 20);
      }

      allow read: if logueado();
      allow create: if logueado()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.nombre is string
        && categoriaValida();
      allow update: if logueado()
        && resource.data.userId == request.auth.uid
        && !("userId" in camposTocados())
        && categoriaValida();
      allow delete: if logueado() && resource.data.userId == request.auth.uid;
    }

    // ── Asistencias ───────────────────────────────────────────────────────────
    // Se leen las propias y las de los grupos de los que sos miembro (fase 2). Toda
    // query de la app filtra por grupoId (o userId): si no, Firestore la rechaza entera.
    // Se crean solo en un grupo del que sos miembro y con tu userId. Al editar,
    // dueño, grupo, usuario y fecha quedan fijos.
    match /asistencias/{docId} {
      // Campos del contenido del entreno, comunes a create y update.
      // tipo / musculos / etiqueta / sexo: registro con cuerpo (2026-09).
      function contenidoValido() {
        return textoOk("notas", 1000)
          && listaOk("rutina", 30)
          && textoOk("categoriaId", 100)
          && textoOk("catId", 100)
          && (!("imagenUrl" in camposTocados())
              || request.resource.data.imagenUrl == null
              || esTextoCorto(request.resource.data.imagenUrl, 2000))
          && (!("tipo" in camposTocados())
              || request.resource.data.tipo in ["gym", "futbol", "running", "otro"])
          && listaOk("musculos", 20)
          && textoOk("etiqueta", 60)
          && (!("sexo" in camposTocados()) || request.resource.data.sexo in ["hombre", "mujer"]);
      }

      allow read: if logueado()
        && (resource.data.userId == request.auth.uid || esMiembroDe(resource.data.grupoId));

      allow create: if logueado()
        && request.resource.data.userId == request.auth.uid
        && esMiembroDe(request.resource.data.grupoId)
        && esTextoCorto(request.resource.data.userName, 80)
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.timestamp is number
        && request.resource.data.get("likes", []) == []
        && contenidoValido();

      allow update: if logueado()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "categoriaId", "notas", "rutina", "imagenUrl", "timestampActualizacion",
             "tipo", "musculos", "etiqueta", "sexo"
           ])
        && contenidoValido();

      allow delete: if logueado() && resource.data.userId == request.auth.uid;
    }

    // ── Grupos ────────────────────────────────────────────────────────────────
    // Solo los miembros (y el admin global) lo leen. Crear y unirse con código van
    // por Cloud Functions (backend/src/grupos/gestionGrupos.js): el cliente no puede
    // buscar un código entre grupos ajenos. El admin del grupo (o el global) edita todo;
    // un miembro solo puede SACARSE a sí mismo.
    match /grupos/{grupoId} {
      function esAdminDelGrupo() {
        return emailVerificado() && request.auth.token.email == resource.data.adminEmail;
      }

      function soloSeSaca() {
        let yo = request.auth.token.email;
        let antes = resource.data.miembros.toSet();
        let despues = request.resource.data.miembros.toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["miembros"])
          && request.resource.data.miembros is list
          && (yo in antes)
          && antes.difference(despues) == [yo].toSet()
          && despues.difference(antes).size() == 0;
      }

      allow read: if esAdminGlobal()
        || (emailVerificado() && request.auth.token.email in resource.data.miembros);

      allow create: if false; // crearGrupo (Cloud Function) con código único

      allow update: if emailVerificado() && (
        ((esAdminDelGrupo() || esAdminGlobal())
          && request.resource.data.miembros is list
          && request.resource.data.miembros.size() <= 100
          && esTextoCorto(request.resource.data.nombre, 60))
        || soloSeSaca()
      );

      allow delete: if esAdminDelGrupo() || esAdminGlobal();
    }

    // ── Colecciones legacy (solo lectura para la migración del fallback) ──────
    // Cada uno lee solo su registro (por doc id = email o por el campo email).
    function esSuRegistroLegacy(docId) {
      return emailVerificado()
        && (docId == request.auth.token.email || resource.data.get("email", "") == request.auth.token.email);
    }

    match /usuariosPendientes/{docId} {
      allow read: if esSuRegistroLegacy(docId);
      allow write: if false;
    }

    match /usuariosPermitidos/{docId} {
      allow read: if esSuRegistroLegacy(docId);
      allow write: if false;
    }
  }
}
