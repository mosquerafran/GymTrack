rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /entrenamientos/{userId}/{allPaths=**} {
      // Solo el usuario dueño puede subir a su carpeta, pero todos pueden leer (para el Feed)
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
